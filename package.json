{
    "name": "pathwise-backend",
    "version": "1.0.0",
    "description": "Complete backend for \"Pathwise\" LMS project",
    "main": "src/server.js",
    "type": "module",
    "scripts": {
        "test": "echo \"No tests yet\" && exit 0",
        "dev": "cross-env NODE_ENV=development nodemon src/server.js",
        "start": "cross-env NODE_ENV=production node src/server.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check"
    },
    "author": "Krut Aghera",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "cross-env": "^10.1.0",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.7.0",
        "prettier": "3.9.4"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "express-validator": "^7.3.2",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.7.3",
        "morgan": "^1.11.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3"
    },
    "lint-staged": {
        "*.{js}": [
            "eslint --fix",
            "prettier --write"
        ]
    }
